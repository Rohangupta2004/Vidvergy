{
  "id": "workspace-660069",
  "name": "Vidverge",
  "description": "Agent-led video creation: describe the outcome once, then Verger plans and runs the right production workflow.",
  "version": "1.0.0",
  "apps": [
    {
      "id": "vidverge-agent",
      "name": "Verger",
      "description": "Vidverge's calm, persistent assistant for planning, creating, editing and tracking video work from one conversation.",
      "icon": "Bot",
      "component": "apps/VidvergeAgent/App.tsx"
    },
    {
      "id": "faceless",
      "name": "Faceless",
      "description": "Narration-first faceless films with editorial planning, generated or sourced visuals, rendering and quality review.",
      "icon": "Film",
      "component": "apps/Faceless/App.tsx"
    },
    {
      "id": "video-enhancer",
      "name": "Video Enhancer",
      "description": "Transcript-led editing, reframing, captions, overlays and export for footage the customer already has.",
      "icon": "Sparkles",
      "component": "apps/VideoEnhancer/App.tsx"
    },
    {
      "id": "script-to-video",
      "name": "Script-to-Video",
      "description": "Turns an approved script into a scene-by-scene film with continuity, review and final assembly.",
      "icon": "Clapperboard",
      "component": "apps/ScriptToVideo/App.tsx"
    },
    {
      "id": "sceneforge",
      "name": "SceneForge",
      "description": "Presenter, avatar and explanatory-video production with premade ElevenLabs voice selection and resumable rendering.",
      "icon": "Film",
      "component": "apps/SceneForge/App.tsx"
    },
    {
      "id": "ads-studio",
      "name": "Vergeye Ads Studio",
      "description": "Save one-time multi-platform ad research, rank real public signals, inspect winning structures, and turn evidence into original campaign briefs.",
      "icon": "Target",
      "component": "apps/AdsStudio/App.tsx"
    },
    {
      "id": "ugc-studio",
      "name": "UGC Studio",
      "description": "Recreate top-performing structures with original brand-safe copy, editable scenes and regional synthetic actors through the existing Runway workflow.",
      "icon": "Video",
      "component": "apps/UGCStudio/App.tsx"
    },
    {
      "id": "video-provider-lab",
      "name": "Video Provider Lab",
      "description": "Diagnostics for comparing the workspace's configured video providers.",
      "icon": "FlaskConical",
      "component": "apps/VideoProviderLab/App.tsx"
    },
    {
      "id": "cineagent",
      "name": "CineAgent",
      "description": "Autonomous post-production for raw footage: analyse, direct, edit, render and review a finished cut.",
      "icon": "Wand2",
      "component": "apps/CineAgent/App.tsx"
    },
    {
      "id": "brand-context",
      "name": "Brand Kit",
      "description": "Saved, verified brand context reused by Verger and production studios.",
      "icon": "Clipboard",
      "component": "apps/BrandContext/App.tsx"
    }
  ],
