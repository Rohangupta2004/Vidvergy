{
  "id": "workspace-660069",
  "name": "Vidverge",
  "description": "Agent-led video creation: describe the outcome once, then Verger plans and runs the right production workflow.",
  "version": "1.0.0",
  "apps": [
    {
      "id": "home",
      "name": "Verge",
      "description": "Your Vidverge home: one prompt or a chat with Verger, every studio in motion, your Brand doc, running productions, templates and recent renders.",
      "icon": "Home",
      "component": "apps/Home/App.tsx"
    },
    {
      "id": "vidverge-agent",
      "name": "Verger",
      "description": "Vidverge's calm, persistent assistant for planning, creating, editing and tracking video work from one conversation.",
      "icon": "Bot",
      "component": "apps/VidvergeAgent/App.tsx"
    },
    {
      "id": "faceless",
      "name": "Faceless",
      "description": "Narration-first faceless films with editorial planning, generated or sourced visuals, rendering and quality review.",
      "icon": "Film",
      "component": "apps/Faceless/App.tsx"
    },
    {
      "id": "video-enhancer",
      "name": "Video Enhancer",
      "description": "Describe the edit and the Enhancer Agent runs it — grades, restoration, stabilization, captions, reframing, cuts, Omni Flash restyles and background swaps, each undoable — or enhance in batches and edit on a timeline.",
      "icon": "Sparkles",
      "component": "apps/VideoEnhancer/App.tsx"
    },
    {
      "id": "script-to-video",
      "name": "Script-to-Video",
      "description": "Turns an approved script into a scene-by-scene film with continuity, review and final assembly.",
      "icon": "Clapperboard",
      "component": "apps/ScriptToVideo/App.tsx"
    },
    {
      "id": "sceneforge",
      "name": "SceneForge",
      "description": "Presenter, avatar and explanatory-video production with premade ElevenLabs voice selection and resumable rendering.",
      "icon": "Film",
      "component": "apps/SceneForge/App.tsx"
    },
    {
      "id": "avatar-app",
      "name": "Avatar App",
      "description": "Full HeyGen v3 avatar production, translation, batches and brand-kit workflows with HyperFrames-only finishing in 9:16, 1:1 and 16:9.",
      "icon": "UserRound",
      "component": "apps/AvatarApp/App.tsx"
    },
    {
      "id": "ads-studio",
      "name": "Vergeye Ads Studio",
      "description": "Save one-time multi-platform ad research, rank real public signals, inspect winning structures, and turn evidence into original campaign briefs.",
      "icon": "Target",
      "component": "apps/AdsStudio/App.tsx"
    },
    {
      "id": "ugc-studio",
      "name": "UGC Studio",
      "description": "Recreate top-performing structures with original brand-safe copy, editable scenes and regional synthetic actors through the existing Runway workflow.",
      "icon": "Video",
      "component": "apps/UGCStudio/App.tsx"
    },
    {
      "id": "video-provider-lab",
      "name": "Video Provider Lab",
      "description": "Direct single-clip generation with the workspace's video models, plus a 3D Scene Builder to compose, render and animate custom scenes; owner diagnostics remain in Health.",
      "icon": "FlaskConical",
      "component": "apps/VideoProviderLab/App.tsx"
    },
    {
      "id": "cineagent",
      "name": "CineAgent",
      "description": "Autonomous post-production for raw footage: analyse, direct, edit, render and review a finished cut.",
      "icon": "Wand2",
      "component": "apps/CineAgent/App.tsx"
    },
    {
      "id": "health",
      "name": "Health",
      "description": "Owner monitoring for crashes, provider failures, quality and refunds.",
      "icon": "Activity",
      "component": "apps/Health/App.tsx",
      "allowedRoles": [
        "owner"
      ]
    },
    {
      "id": "pricing",
      "name": "Pricing",
      "description": "Vidverge pricing: pay-per-use credit packs.",
      "icon": "DollarSign",
      "component": "apps/Pricing/App.tsx",
      "public": true,
      "hidden": true,
      "route": "/pricing"
    },
    {
      "id": "terms",
      "name": "Terms",
      "description": "Vidverge Terms of Service.",
      "icon": "FileText",
      "component": "apps/Legal/App.tsx",
      "public": true,
      "route": "/terms"
    },
    {
      "id": "privacy",
      "name": "Privacy",
      "description": "Vidverge Privacy Policy.",
      "icon": "Shield",
      "component": "apps/Legal/App.tsx",
      "public": true,
      "route": "/privacy"
    },
    {
      "id": "refund",
      "name": "Refund Policy",
      "description": "Vidverge Refund Policy.",
      "icon": "Receipt",
      "component": "apps/Legal/App.tsx",
      "public": true,
      "route": "/refund"
    },
    {
      "id": "terms-of-service",
      "name": "Terms of Service",
      "description": "Vidverge Terms of Service.",
      "icon": "FileText",
      "component": "apps/Legal/App.tsx",
      "public": true,
      "hidden": true,
      "route": "/terms-of-service"
    },
    {
      "id": "privacy-policy",
      "name": "Privacy Policy",
      "description": "Vidverge Privacy Policy.",
      "icon": "Shield",
      "component": "apps/Legal/App.tsx",
      "public": true,
      "hidden": true,
      "route": "/privacy-policy"
    }
  ],
  "routes": [
    { "path": "/pricing", "target": "shell", "appId": "pricing", "public": true },
    { "path": "/terms", "target": "shell", "appId": "terms", "public": true },
    { "path": "/privacy", "target": "shell", "appId": "privacy", "public": true },
    { "path": "/refund", "target": "shell", "appId": "refund", "public": true },
    { "path": "/terms-of-service", "target": "shell", "appId": "terms-of-service", "public": true },
    { "path": "/privacy-policy", "target": "shell", "appId": "privacy-policy", "public": true }
  ],
